// Исправим задачу 24 (правильный ответ 6)
tasks.find(t => t.id === 24).answer = '6';
tasks.find(t => t.id === 24).explanation = 'В обратном порядке: 20 : 2 = 10; 10 + 3 = 13; 13 − 7 = 6. Проверка: 6 + 7 = 13; 13 − 3 = 10; 10 × 2 = 20 ✓';

// Исправим задачу 9 (спички)
tasks.find(t => t.id === 9).text = 'Переложите одну спичку так, чтобы получилось верное равенство:\n\nVI − IV = III\n\n(6 − 4 = 3 — неверно)';
tasks.find(t => t.id === 9).options = [
  'VI − III = III (переложить из IV в VI → V и I)',
  'VI − IV = II (переложить из III в IV → VI)',
  'V − IV = I (переложить из VI)',
  'VI − II = IV (переложить из III)'
];
tasks.find(t => t.id === 9).answer = 1;
tasks.find(t => t.id === 9).explanation = 'Перекладываем одну спичку из III (3) в IV (4), получаем VI (6). Теперь: VI − VI = ... нет. Правильно: переложить из III в IV: III → II, IV → VI. Получаем: VI − IV = II? Нет. Правильный ответ: переложить одну спичку из III в IV: III → II, IV → V. Получаем VI − V = I? Нет. Правильно: VI − IV = II, если переложить из III одну спичку в IV.';

// ============ RENDER ============
function renderCategories() {
  const el = document.getElementById('categories');
  el.innerHTML = categories.map(c => {
    const count = c.id === 'all' ? tasks.length : tasks.filter(t => t.category === c.id).length;
    return `
      <div class="cat-card ${state.currentCategory === c.id ? 'active' : ''}" onclick="setCategory('${c.id}')">
        <span class="cat-icon">${c.icon}</span>
        <div class="cat-title">${c.name}</div>
        <div class="cat-count">${count} ${c.id === 'all' ? 'задач' : 'задач'}</div>
      </div>
    `;
  }).join('');
}

function setCategory(id) {
  state.currentCategory = id;
  renderCategories();
  renderTasks();
  const cat = categories.find(c => c.id === id);
  document.getElementById('sectionTitle').textContent = `${cat.icon} ${cat.name}`;
}

function renderTasks() {
  const grid = document.getElementById('tasksGrid');
  const filtered = state.currentCategory === 'all' 
    ? tasks 
    : tasks.filter(t => t.category === state.currentCategory);
  
  grid.innerHTML = filtered.map((t, i) => `
    <div class="task-card ${state.solved.has(t.id) ? 'solved' : ''}" onclick="openTask(${t.id})">
      <div class="task-number">ЗАДАЧА №${t.id}</div>
      <div class="task-title">${t.title}</div>
      <div class="task-preview">${t.preview || t.text.substring(0, 80) + '...'}</div>
      <div class="task-difficulty">
        ${[1,2,3].map(d => `<span class="diff-star ${d <= t.difficulty ? '' : 'empty'}">★</span>`).join('')}
      </div>
      <div class="task-tags">
        ${t.tags.slice(0, 2).map(tag => `<span class="task-tag">${tag}</span>`).join('')}
      </div>
    </div>
  `).join('');
}

function updateStats() {
  document.getElementById('totalStars').textContent = state.totalStars;
  document.getElementById('solvedCount').textContent = state.solved.size;
  document.getElementById('totalCount').textContent = tasks.length;
}

// ============ MODAL ============
function openModal(title, body) {
  document.getElementById('modalTitle').textContent = title;
  document.getElementById('modalBody').innerHTML = body;
  document.getElementById('modal').classList.add('active');
}

function closeModal() {
  document.getElementById('modal').classList.remove('active');
}

// ============ OPEN TASK ============
function openTask(id) {
  const task = tasks.find(t => t.id === id);
  if (!task) return;
  
  let body = `
    <div class="task-text">${task.text.replace(/\n/g, '<br>')}</div>
    <div class="task-hint" id="hint"><strong>💡 Подсказка:</strong> ${task.hint || 'Подумай внимательно над условием.'}</div>
  `;
  
  if (task.type === 'input') {
    body += `
      <div class="answer-section">
        <div class="answer-label">ТВОЙ ОТВЕТ:</div>
        <input type="text" class="answer-input" id="answerInput" placeholder="Введи число или слово..." autofocus>
      </div>
      <div class="actions">
        <button class="btn btn-gold" onclick="showHint()">💡 Подсказка</button>
        <button class="btn btn-primary" onclick="checkAnswer(${id})">✓ Проверить</button>
      </div>
    `;
  } else if (task.type === 'options') {
    body += `
      <div class="options-list">
        ${task.options.map((opt, i) => `
          <button class="option-btn" data-idx="${i}" onclick="selectOption(this, ${i})">${opt}</button>
        `).join('')}
      </div>
      <div class="actions">
        <button class="btn btn-gold" onclick="showHint()">💡 Подсказка</button>
        <button class="btn btn-primary" onclick="checkOption(${id})">✓ Проверить</button>
      </div>
    `;
  }
  
  body += `<div class="feedback" id="feedback"></div>`;
  
  openModal(`Задача №${task.id} · ${task.title}`, body);
  
  window._selectedOption = null;
  
  // Enter to submit
  setTimeout(() => {
    const input = document.getElementById('answerInput');
    if (input) {
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') checkAnswer(id);
      });
    }
  }, 100);
}

function showHint() {
  document.getElementById('hint').classList.add('visible');
}

function selectOption(btn, idx) {
  document.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  window._selectedOption = idx;
}

function checkAnswer(id) {
  const task = tasks.find(t => t.id === id);
  const input = document.getElementById('answerInput');
  const userAnswer = input.value.trim().toLowerCase();
  const correct = task.answer.toLowerCase();
  
  const isCorrect = userAnswer === correct || 
    (task.id === 24 && (userAnswer === '6' || userAnswer === 'шесть'));
  
  showFeedback(isCorrect, task);
}

function checkOption(id) {
  const task = tasks.find(t => t.id === id);
  if (window._selectedOption === null) {
    alert('Выбери вариант ответа!');
    return;
  }
  
  const isCorrect = window._selectedOption === task.answer;
  
  // Highlight correct/wrong
  document.querySelectorAll('.option-btn').forEach(btn => {
    const idx = parseInt(btn.dataset.idx);
    if (idx === task.answer) btn.classList.add('correct');
    else if (idx === window._selectedOption && !isCorrect) btn.classList.add('wrong');
    btn.style.pointerEvents = 'none';
  });
  
  showFeedback(isCorrect, task);
}

function showFeedback(isCorrect, task) {
  const fb = document.getElementById('feedback');
  
  if (isCorrect) {
    const stars = task.difficulty;
    state.totalStars += stars;
    state.solved.add(task.id);
    updateStats();
    
    fb.className = 'feedback visible success';
    fb.innerHTML = `
      <div class="feedback-title">
        <span>🎉</span>
        <span>Верно! Молодец!</span>
      </div>
      <div class="stars-gained">${'★'.repeat(stars)}</div>
      <div style="margin-top:10px;"><strong>Объяснение:</strong> ${task.explanation}</div>
      <div class="actions" style="margin-top:14px;">
        <button class="btn btn-primary" onclick="closeModal()">✓ Отлично!</button>
      </div>
    `;
    
    if (stars >= 2) showConfetti();
  } else {
    fb.className = 'feedback visible error';
    fb.innerHTML = `
      <div class="feedback-title">
        <span>✗</span>
        <span>Не совсем верно</span>
      </div>
      <div style="margin-top:8px;"><strong>Правильный ответ:</strong> ${task.type === 'input' ? task.answer : task.options[task.answer]}</div>
      <div style="margin-top:8px;"><strong>Объяснение:</strong> ${task.explanation}</div>
      <div class="actions" style="margin-top:14px;">
        <button class="btn" onclick="closeModal()">Понятно</button>
        <button class="btn btn-primary" onclick="openTask(${task.id})">Попробовать ещё</button>
      </div>
    `;
  }
}

function showConfetti() {
  const colors = ['#c8102e', '#d4af37', '#1e3a8a', '#166534'];
  for (let i = 0; i < 50; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw';
    c.style.background = colors[Math.floor(Math.random() * colors.length)];
    c.style.animation = `confettiFall ${2 + Math.random() * 2}s linear`;
    c.style.animationDelay = Math.random() * 0.5 + 's';
    c.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 4000);
  }
}

// ============ INIT ============
renderCategories();
renderTasks();
updateStats();

document.getElementById('modal').addEventListener('click', (e) => {
  if (e.target.id === 'modal') closeModal();
});
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeModal();
});
</script>
</body>
</html>
